{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.invalid/schema/control.schema.json",
  "title": "AgentGov Auditor control definition",
  "description": "One versioned control in the AgentGov Auditor catalog. The 24 controls are this project's own governance model. They are not an official standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "intent",
    "plain_language",
    "applicability",
    "evidence_types",
    "detectors",
    "dynamic_tests",
    "verification_rules",
    "remediation",
    "severity",
    "default_weight",
    "standards_mappings",
    "limitations",
    "examples"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^AGC-0(0[1-9]|1[0-9]|2[0-4])$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "domain": {
      "enum": [
        "A: Accountability",
        "B: Identity and Access",
        "C: Action Controls",
        "D: Trust Boundaries",
        "E: Containment and Recovery",
        "F: Assurance and Visibility"
      ]
    },
    "intent": { "type": "string", "minLength": 20 },
    "plain_language": { "type": "string", "minLength": 10, "maxLength": 200 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rationale"],
      "properties": {
        "mode": { "enum": ["always", "capability"] },
        "capabilities_any": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tools",
              "sensitive-actions",
              "mutating-actions",
              "shell-exec",
              "code-exec",
              "filesystem",
              "network",
              "browser",
              "data-access",
              "memory",
              "multi-agent",
              "mcp",
              "credentials",
              "container"
            ]
          }
        },
        "rationale": { "type": "string", "minLength": 10 }
      },
      "if": { "properties": { "mode": { "const": "capability" } } },
      "then": { "required": ["capabilities_any"] },
      "else": { "not": { "required": ["capabilities_any"] } }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "static",
          "configuration",
          "test",
          "runtime",
          "external-attestation",
          "manual-review"
        ]
      }
    },
    "detectors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^AGC-0[0-9]{2}\\.[a-z0-9*.-]+$" }
    },
    "dynamic_tests": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    },
    "verification_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "tested", "operational", "max_static_maturity"],
      "properties": {
        "implementation": { "type": "string", "minLength": 10 },
        "tested": { "type": "string", "minLength": 10 },
        "operational": { "type": "string", "minLength": 10 },
        "max_static_maturity": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "remediation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 10 }
    },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "default_weight": { "type": "integer", "minimum": 1, "maximum": 100 },
    "standards_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard", "version", "requirement_id", "url", "rationale"],
        "properties": {
          "standard": { "type": "string", "minLength": 3 },
          "version": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "rationale": { "type": "string", "minLength": 10 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "string", "minLength": 10 },
        "negative": { "type": "string", "minLength": 10 }
      }
    }
  }
}
