{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.invalid/schema/agentgov-config.schema.json",
  "title": "AgentGov Auditor configuration (.agentgov.yaml)",
  "description": "Optional repository configuration. It declares the agent and may raise requirements. It is never evidence that a control is implemented, and it cannot weaken an organization baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "description": "Version of this configuration format. Must be the string \"1\".",
      "const": "1"
    },
    "agent": { "$ref": "#/$defs/agent" },
    "agents": {
      "description": "For monorepos: several agents, each with its own root directory.",
      "type": "array",
      "items": {
        "allOf": [{ "$ref": "#/$defs/agent" }],
        "required": ["id", "root"]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_tools": { "$ref": "#/$defs/nameList" },
        "sensitive_actions": { "$ref": "#/$defs/nameList" },
        "external_connectivity": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["baseline", "standard", "high-risk"] },
        "tests_path": { "$ref": "#/$defs/relativePath" },
        "evidence_paths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "offline": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack": { "enum": ["builtin/v1"] },
        "mandatory_controls": {
          "description": "Controls to add to the mandatory set of the profile. This list can add controls. It cannot remove any.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/controlID" }
        },
        "min_maturity": {
          "description": "Minimum maturity for mandatory controls. A value below the profile minimum has no effect.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "not_applicable": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        },
        "accepted_risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redact_sensitive_data": { "type": "boolean" },
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["terminal", "json", "markdown", "html", "sarif"] }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "max_file_size": {
          "description": "Largest file the scanner reads, in bytes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      }
    }
  },
  "$defs": {
    "controlID": {
      "type": "string",
      "pattern": "^AGC-0(0[1-9]|1[0-9]|2[0-4])$"
    },
    "date": {
      "description": "Calendar date in the form YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "relativePath": {
      "description": "Repository-relative path with forward slashes. It must not be absolute and must not contain a \"..\" segment.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\:][^\\\\:]*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "nameList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 512,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "root": { "$ref": "#/$defs/relativePath" },
        "owner": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "purpose": { "type": "string", "maxLength": 2000 },
        "risk_tier": { "enum": ["low", "medium", "high"] },
        "risk_rationale": { "type": "string", "maxLength": 2000 },
        "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "registry_ref": { "type": "string", "maxLength": 500 },
        "last_reviewed": { "$ref": "#/$defs/date" },
        "reviewer": { "type": "string", "maxLength": 200 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "reason", "approved_by"],
      "properties": {
        "control": { "$ref": "#/$defs/controlID" },
        "reason": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "approved_by": { "type": "string", "minLength": 2, "maxLength": 200 },
        "expires": { "$ref": "#/$defs/date" }
      }
    }
  }
}
