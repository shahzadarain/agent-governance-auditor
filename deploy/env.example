# SPDX-License-Identifier: Apache-2.0
#
# STATUS: not yet verified on a Docker host.
#
# Copy this file to deploy/.env and review every value. The file holds no
# secret defaults. Never commit deploy/.env.
#
# The server has no default user and no default password. The first
# administrator is created with a one-time bootstrap token that the server
# prints to its log on first start.

# Address the server listens on. Default: 127.0.0.1:8080.
# With Docker Compose leave this unset: compose.yaml sets 0.0.0.0:8080 inside
# the container and publishes the port on 127.0.0.1 of the host only.
#AGENTGOV_LISTEN=127.0.0.1:8080

# Required to listen on any address that is not loopback. The server refuses
# to start otherwise. Set it only behind a TLS reverse proxy and a firewall.
# With Docker Compose leave this unset: compose.yaml sets it for the
# container.
#AGENTGOV_ALLOW_PUBLIC=false

# Directory for the SQLite database (agentgov.db) when AGENTGOV_DATABASE_URL
# is not set. Compose sets /data (a named volume).
#AGENTGOV_DATA_DIR=./data

# Database. Forms:
#   sqlite:///absolute/path/agentgov.db
#   /absolute/or/relative/path/agentgov.db
#   postgres://user:password@host:5432/dbname?sslmode=...   (EXPERIMENTAL, untested)
# Leave unset to use SQLite in AGENTGOV_DATA_DIR.
#AGENTGOV_DATABASE_URL=

# Comma-separated IP addresses or CIDR ranges of reverse proxies. The server
# honors X-Forwarded-For and X-Forwarded-Proto only from these addresses.
# Leave empty when no reverse proxy is used.
AGENTGOV_TRUSTED_PROXIES=

# Maximum size of one scan upload in bytes. Default: 5242880 (5 MiB).
AGENTGOV_MAX_UPLOAD_BYTES=5242880

# --- PostgreSQL profile only (deploy/compose.postgres.yaml) ----------------
# No default. Compose refuses to start the PostgreSQL profile while this is
# empty. Generate a long random value of letters and digits, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
